      "clock_frozen_at_done": true,
      "finished_elapsed_uses_it": true,
      "snapshot_is_documented": true
    },
    "payload": {
      "fields": [
        "auto_unload",
        "messages",
        "model",
        "reasoning_mode",
        "skills",
        "tools_enabled",
        "workspace_dir"
