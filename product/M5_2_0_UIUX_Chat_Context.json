{
  "schema_version": "1.0.0",
  "story": "UIUX-P2-05",
  "statement": "Every Chat answer records the context it was sent - persona, reasoning mode, tools, skills, message count and the directory that will be read - and prints it; every tool call prints a status word, its step, its time and the size of its arguments, with the arguments and the server's capped output one disclosure below; and a streaming turn reports how long it has been going and when the first token arrived, measured.",
  "source": {
    "frontend": "static/index.html",
    "server": "app.py",
    "routes": [
      "/api/chat/stream"
    ]
  },
  "server": {
    "route": "/api/chat/stream",
    "event": "chat_tool",
    "fields": [
      "args",
      "elapsed_ms",
      "ok",
      "preview",
      "step",
      "tool"
    ],
    "preview_cap": 500
  },
  "context_fields": [
    "messages",
    "model",
    "persona",
    "reasoning",
    "skills",
    "tools",
    "workspace",
    "workspace_effective"
  ],
  "tool_event_fields": [
    "step",
    "tool",
    "args",
    "ok",
    "elapsed_ms",
    "preview"
  ],
  "tool_output_cap": 500,
  "frontend": {
    "functions": {
      "chatContextSnapshot": true,
      "chatContextLine": true,
      "renderChatTool": true,
      "chatToolSummary": true,
      "chatStreamingMeta": true
    },
    "context": {
      "captured_at_send": true,
      "not_recomputed": true,
      "persona_from_the_helper": true,
      "attached_to_the_turn": true,
      "rendered": true,
      "fields": [
        "messages",
        "model",
        "persona",
        "reasoning",
        "skills",
        "tools",
        "workspace",
        "workspace_effective"
      ],
      "sent_vs_effective": true,
      "payload_reads_the_same_values": true,
      "persona_label_from_the_select": true,
      "skills_count_from_the_set": true,
      "message_count_from_the_request": true,
      "line_names_the_model": true,
      "line_names_the_effective_workspace": true,
      "skills_only_when_sent": true
    },
    "tools": {
      "status_word": true,
      "status_rendered": true,
      "status_tone": true,
      "not_colour_only": true,
      "step_shown": true,
      "elapsed_shown": true,
      "args_size_shown": true,
      "full_args_in_body": true,
      "args_not_truncated": true,
      "output_cap_stated": true,
      "summary_counts": true,
      "summary_total_ms": true,
      "summary_rendered": true,
      "rows_rendered": true,
      "reasoning_size": true,
      "turn_marks_failed_turns": true
