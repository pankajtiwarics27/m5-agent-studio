  "quality_model": {
    "rubric_id": "ap-quality-v1",
    "version": 1,
    "scoring_scale": {
      "minimum": 0,
      "maximum": 4,
      "labels": {
        "0": "absent_or_harmful",
        "1": "major_repair",
        "2": "partial",
        "3": "acceptable",
        "4": "strong"
      }
    },
    "aggregation_policy": {
      "category_scores_remain_separate": true,
      "hard_gates_cannot_be_averaged_away": true,
      "single_grader_cannot_certify_all_categories": true,
      "record_failures_and_variability": true
    },
    "categories": [
      {
        "id": "technical",
        "description": "Whether the requested functions work and the delivered artifact is valid, usable, accessible, and recoverable.",
        "criteria": [
          {
            "id": "T01",
            "description": "Required functions and interactions complete end to end without a false-success state.",
            "evidence_types": [
              "deterministic_check",
              "artifact_inspection"
            ],
            "hard_gate": true
          },
          {
            "id": "T02",
            "description": "The artifact parses, opens, renders, or decodes in the applicable real consumer.",
            "evidence_types": [
              "deterministic_check",
              "real_consumer_inspection"
            ],
            "hard_gate": true
          },
          {
            "id": "T03",
            "description": "Accessibility, cancellation, failure reporting, and recovery are appropriate to the output type.",
            "evidence_types": [
              "adversarial_check",
              "recovery_check"
            ],
            "hard_gate": true
          }
        ]
      },
      {
        "id": "factual",
        "description": "Whether claims are supported by suitable evidence and uncertainty or contradiction is made explicit.",
        "criteria": [
          {
            "id": "F01",
            "description": "Consequential claims map to dated sources or supplied evidence with provenance.",
            "evidence_types": [
              "source_map",
              "claim_review"
            ],
            "hard_gate": true
          },
          {
            "id": "F02",
            "description": "Uncertainty, missing evidence, and contradictory sources are disclosed rather than guessed away.",
            "evidence_types": [
              "claim_review",
              "contradiction_check"
            ],
            "hard_gate": true
          },
          {
            "id": "F03",
            "description": "Quoted, derived, and original material remain distinguishable.",
            "evidence_types": [
              "provenance_review"
            ],
            "hard_gate": false
          }
        ]
      },
      {
        "id": "creative",
        "description": "Whether the work fits its audience, has coherent style and pacing, and avoids generic or derivative execution.",
        "criteria": [
          {
            "id": "C01",
            "description": "Voice, visual language, structure, and pacing fit the stated fictional brief.",
            "evidence_types": [
              "blinded_review",
              "artifact_inspection"
            ],
            "hard_gate": false
          },
          {
            "id": "C02",
            "description": "The output is coherent and sufficiently original for the task rather than a template-only substitution.",
            "evidence_types": [
              "blinded_review",
              "similarity_review"
            ],
            "hard_gate": false
          },
          {
            "id": "C03",
            "description": "Creative choices support rather than obscure factual and functional requirements.",
            "evidence_types": [
              "cross_category_review"
            ],
            "hard_gate": false
          }
        ]
      },
      {
        "id": "practical",
        "description": "Whether the result is useful to the intended fictional audience and objective without claiming demand or revenue.",
        "criteria": [
          {
            "id": "P01",
            "description": "A recipient can understand and use the delivery package without hidden operator repair.",
            "evidence_types": [
              "task_completion_review",
              "delivery_check"
            ],
            "hard_gate": true
          },
          {
            "id": "P02",
            "description": "Limitations, dependencies, costs, and separately authorised next actions are explicit.",
            "evidence_types": [
              "delivery_check",
              "policy_review"
            ],
            "hard_gate": true
          },
          {
            "id": "P03",
            "description": "The artifact addresses the stated outcome but makes no unsupported demand, revenue, or production-readiness claim.",
            "evidence_types": [
              "objective_review"
            ],
            "hard_gate": false
          }
        ]
      }
    ]
  },
